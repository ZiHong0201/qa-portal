// Prisma schema for the Q&A credit portal
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  STUDENT
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE
  FREE_RESPONSE
}

enum SubmissionStatus {
  PENDING // free-response answer awaiting teacher review
  CORRECT // auto-graded multiple choice, correct
  INCORRECT // auto-graded multiple choice, incorrect
  APPROVED // free-response answer approved by a teacher
  REJECTED // free-response answer rejected by a teacher
}

// Master data: the set of valid grades/subjects admins can assign to
// students and question sets. Managed at /admin/master-data. Referenced by
// name (not a foreign key) from User.grade/subject and
// QuestionSet.grade/subject, so those stay simple strings while still being
// validated against this list at write time.
model Grade {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  grade        String? // e.g. "Form 1" .. "Form 5" - students only
  createdAt    DateTime @default(now())

  // The virtual cat is opt-in per student, off by default: an admin turns it
  // on for whoever it suits. Gating on a column rather than "has a pet row"
  // means access can be withdrawn without destroying the cat they raised.
  petEnabled Boolean @default(false)

  createdQuestionSets QuestionSet[]  @relation("QuestionSetCreator")
  createdQuestions Question[]   @relation("QuestionCreator")
  submissions      Submission[] @relation("SubmissionStudent")
  reviewedSubmissions Submission[] @relation("SubmissionReviewer")

  createdCatalogueItems CatalogueItem[]   @relation("CatalogueItemCreator")
  redemptions           Redemption[]      @relation("StudentRedemptions")
  pointAdjustments      PointAdjustment[] @relation("StudentPointAdjustments")
  madeAdjustments       PointAdjustment[] @relation("PointAdjustmentCreator")

  subjects StudentSubject[] // students only - a student can take multiple subjects
  checkIns CheckIn[]        @relation("StudentCheckIns")

  createdAnnouncements Announcement[] @relation("AnnouncementCreator")
  createdPopupAds      PopupAd[]      @relation("PopupAdCreator")

  pet          Pet?          @relation("StudentPet")
  petPurchases PetPurchase[] @relation("StudentPetPurchases")
}

// A notice that scrolls across the top of the portal. Admins write the text
// and choose the window it runs for at /admin/announcements. Several can be
// stored at once; whichever are live at page load share the ticker.
model Announcement {
  id      String @id @default(cuid())
  message String

  // The window this runs for, as UTC instants. The admin picks them in
  // Malaysian time (see CHECK_IN_TIME_ZONE) and the action converts. A null
  // start means "live already"; a null end means "until switched off".
  startsAt DateTime?
  endsAt   DateTime?

  // A manual off switch, independent of the dates - so a notice can be pulled
  // early, or written ahead of time and armed later, without losing the window.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation("AnnouncementCreator", fields: [createdById], references: [id])
  createdById String

  // Every page load asks "what is live right now", so the filter columns are
  // indexed together.
  @@index([isActive, startsAt, endsAt])
}

// A full-image notice shown over the page once per login, managed alongside
// the ticker at /admin/announcements. Same on/off switch and scheduling window
// as Announcement; the difference is that this one is a picture, so the image
// is the whole point and the caption is optional.
model PopupAd {
  id       String  @id @default(cuid())
  title    String?
  imageUrl String
  // Optional click-through. Stored as given and rendered with rel="noopener",
  // since it can point anywhere off-site.
  linkUrl  String?

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation("PopupAdCreator", fields: [createdById], references: [id])
  createdById String

  @@index([isActive, startsAt, endsAt])
}

// One row per day a student opens the portal and claims their daily bonus.
// The bonus marks live here rather than in PointAdjustment because that model
// requires an admin as createdById, and a check-in has no admin behind it.
model CheckIn {
  id String @id @default(cuid())

  student   User   @relation("StudentCheckIns", fields: [studentId], references: [id])
  studentId String

  // The calendar day in CHECK_IN_TIME_ZONE as "YYYY-MM-DD". Stored as a
  // string so "one check-in per day" is a plain unique constraint instead of
  // a timestamp-range query that would shift with the server's zone.
  day String

  // Consecutive days including this one, snapshotted at claim time so the
  // history stays readable even if a later day is missed.
  streak        Int @default(1)
  pointsAwarded Int @default(0)

  createdAt DateTime @default(now())

  @@unique([studentId, day])
}

// A subject (by name, matching Subject master data) a student is enrolled
// in. Many-to-many via a plain join table since Subject is referenced by
// name elsewhere too (see the comment on the Grade/Subject models above).
model StudentSubject {
  id        String   @id @default(cuid())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  subject   String
  createdAt DateTime @default(now())

  @@unique([studentId, subject])
}

// A gift/reward students can redeem with their points balance.
model CatalogueItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  cost        Int // points required to redeem
  isActive    Boolean  @default(true)

  // Redeeming this unlocks the virtual cat instead of handing over a physical
  // gift - it flips User.petEnabled. An admin can still grant or revoke access
  // directly at /admin/pet; this is the route a student can take themselves.
  grantsPet Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation("CatalogueItemCreator", fields: [createdById], references: [id])
  createdById String

  redemptions Redemption[]
}

// A student spending points on a catalogue item. `cost` is snapshotted at
// redemption time so later price changes don't rewrite history.
model Redemption {
  id        String   @id @default(cuid())
  cost      Int
  createdAt DateTime @default(now())

  student   User   @relation("StudentRedemptions", fields: [studentId], references: [id])
  studentId String

  catalogueItem   CatalogueItem @relation(fields: [catalogueItemId], references: [id])
  catalogueItemId String
}

// A manual admin credit/deduction to a student's points balance, outside of
// quiz grading (e.g. correcting a mistake, awarding a bonus).
model PointAdjustment {
  id        String   @id @default(cuid())
  amount    Int // positive = credit, negative = deduct
  reason    String?
  createdAt DateTime @default(now())

  student   User   @relation("StudentPointAdjustments", fields: [studentId], references: [id])
  studentId String

  createdBy   User   @relation("PointAdjustmentCreator", fields: [createdById], references: [id])
  createdById String
}

model QuestionSet {
  id            String   @id @default(cuid())
  title         String
  description   String?
  subject       String   @default("General") // e.g. "Mathematics" - students only see their own subject's sets
  simulationUrl String? // optional embedded interactive simulation related to this set's topic (e.g. a PhET sim)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation("QuestionSetCreator", fields: [createdById], references: [id])
  createdById String

  questions Question[]
  grades    QuestionSetGrade[] // a set can be shared across multiple grades
}

// A grade (by name, matching Grade master data) a question set is visible
// to. Many-to-many via a plain join table, same pattern as StudentSubject
// above - a set like a shared "General Science" chapter can be assigned to
// more than one grade instead of just one.
model QuestionSetGrade {
  id            String      @id @default(cuid())
  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questionSetId String
  grade         String
  createdAt     DateTime    @default(now())

  @@unique([questionSetId, grade])
}

model Question {
  id          String       @id @default(cuid())
  body        String
  explanation String?
  diagramUrl  String?
  // AI-generated study nudges for the cat companion, don't reveal the answer -
  // generated once by scripts/generate-hints.mjs and cached here
  hint1 String?
  hint2 String?
  type        QuestionType
  points      Int          @default(10)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questionSetId String

  createdBy   User   @relation("QuestionCreator", fields: [createdById], references: [id])
  createdById String

  choices     Choice[]
  submissions Submission[]
}

model Choice {
  id         String  @id @default(cuid())
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String

  submissions Submission[]
}

model Submission {
  id     String @id @default(cuid())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String

  student   User   @relation("SubmissionStudent", fields: [studentId], references: [id])
  studentId String

  // set when the question is MULTIPLE_CHOICE
  selectedChoice   Choice? @relation(fields: [selectedChoiceId], references: [id])
  selectedChoiceId String?

  // set when the question is FREE_RESPONSE
  answerText String?

  status        SubmissionStatus @default(PENDING)
  pointsAwarded Int              @default(0)

  // --- integrity signals -------------------------------------------------
  // Recorded to help a teacher spot answers worth a conversation. None of
  // them proves anything on its own: a fast correct answer often just means
  // the student knew it, and a tab switch is as likely to be a notification
  // as anything else. They are shown to the admin as context, never as a
  // verdict, and never to the student while they are answering.

  /** Seconds between the question appearing and the answer being submitted. */
  secondsTaken Int?
  /** Times the tab lost focus while this question was open. */
  awayCount Int @default(0)
  /** Total seconds spent with the tab hidden while this question was open. */
  awaySeconds Int @default(0)
  /** Paste attempts blocked on this question. */
  pasteAttempts Int @default(0)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewer   User?     @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  reviewerId String?

  // a student may only answer a given question once
  @@unique([questionId, studentId])
}

// ---------------------------------------------------------------------------
// Virtual cat. Opt-in per student (User.petEnabled), paid for out of the same
// points balance as the catalogue, so a snack genuinely competes with saving
// for a real reward.
// ---------------------------------------------------------------------------

enum PetItemKind {
  CLOTHING // worn, kept forever, can be taken on and off
  FOOD // eaten once, mostly fills hunger
  SNACK // eaten once, mostly raises happiness
}

model Pet {
  id      String @id @default(cuid())
  owner   User   @relation("StudentPet", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String @unique // one cat per student

  name String
  // Coat colour chosen at adoption, as a key the renderer maps to fills.
  coat String @default("grey")

  // Hunger and happiness as they stood at statsAt. They decay with real time,
  // so the value that matters is derived on read - see currentStats() in
  // src/lib/pet.ts. Storing a reading plus its timestamp keeps this to plain
  // arithmetic instead of a scheduled job ticking every pet in the database.
  hunger    Int      @default(100)
  happiness Int      @default(100)
  statsAt   DateTime @default(now())

  adoptedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owned     PetOwnedItem[]
  purchases PetPurchase[]
}

// Something an admin has put in the shop. Clothing is bought once and kept;
// food and snacks are consumed on purchase.
model PetItem {
  id String @id @default(cuid())

  // Stable identifier the SVG renderer switches on, e.g. "hat-party". Kept
  // separate from the display name so an admin can rename an item without
  // the artwork disappearing.
  key  String      @unique
  name String
  kind PetItemKind

  // Clothing only: which layer it occupies, so a second hat replaces the
  // first rather than stacking. Null for food and snacks.
  slot String?

  cost Int

  // Food and snacks only: what eating it adds, before clamping to 100.
  hungerEffect    Int @default(0)
  happinessEffect Int @default(0)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owned     PetOwnedItem[]
  purchases PetPurchase[]

  @@index([kind, isActive, sortOrder])
}

// A piece of clothing a pet owns. Food is never recorded here - it is eaten
// at the moment of purchase.
model PetOwnedItem {
  id String @id @default(cuid())

  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId String

  item   PetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  equipped   Boolean  @default(false)
  acquiredAt DateTime @default(now())

  @@unique([petId, itemId]) // buying the same hat twice is a no-op, not a duplicate
}

// Every point spent on the cat. Separate from Redemption, which is tied to a
// CatalogueItem, but subtracted from the same balance - see getStudentBalance.
// cost is snapshotted so later price changes never rewrite history.
model PetPurchase {
  id String @id @default(cuid())

  // Denormalised onto the student as well as the pet, so the balance query
  // stays a single aggregate rather than a join through Pet.
  student   User   @relation("StudentPetPurchases", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId String

  item   PetItem @relation(fields: [itemId], references: [id])
  itemId String

  cost      Int
  createdAt DateTime @default(now())

  @@index([studentId])
}

// A record of each time the portal was reset back to zero. Exists mainly so
// the scheduled reset can tell whether it has already run - without it, a
// daily job would wipe the portal again every single day after the date
// passes. Doubles as an audit trail of what was destroyed and where the
// snapshot went.
model PortalReset {
  id String @id @default(cuid())

  ranAt DateTime @default(now())

  // The scheduled date this run satisfied. Null for a manual reset, which is
  // what keeps a hand-run reset from cancelling the scheduled one.
  scheduledFor DateTime?

  // Null when run by the cron, otherwise the admin who pressed the button.
  triggeredById String?

  // Where the pre-wipe snapshot was stored. Null only if the export failed
  // and an admin chose to continue anyway.
  snapshotUrl String?

  submissionsCleared  Int @default(0)
  checkInsCleared     Int @default(0)
  adjustmentsCleared  Int @default(0)
  redemptionsCleared  Int @default(0)
  petPurchasesCleared Int @default(0)

  @@index([scheduledFor])
}
