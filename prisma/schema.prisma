// Prisma schema for the Q&A credit portal
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  STUDENT
  // A second teacher: everything academic - sets, questions, grading,
  // students and their points, and the integrity signals - but none of the
  // portal's own configuration. See src/lib/permissions.ts for the split.
  TEACHER
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE
  FREE_RESPONSE
}

enum SubmissionStatus {
  PENDING // free-response answer awaiting teacher review
  CORRECT // auto-graded multiple choice, correct
  INCORRECT // auto-graded multiple choice, incorrect
  APPROVED // free-response answer approved by a teacher
  REJECTED // free-response answer rejected by a teacher
}

// Master data: the set of valid grades/subjects admins can assign to
// students and question sets. Managed at /admin/master-data. Referenced by
// name (not a foreign key) from User.grade/subject and
// QuestionSet.grade/subject, so those stay simple strings while still being
// validated against this list at write time.
model Grade {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  grade        String? // e.g. "Form 1" .. "Form 5" - students only
  createdAt    DateTime @default(now())

  // The virtual cat is opt-in per student, off by default: an admin turns it
  // on for whoever it suits. Gating on a column rather than "has a pet row"
  // means access can be withdrawn without destroying the cat they raised.
  petEnabled Boolean @default(false)

  // Suspension - set by an admin, for unpaid fees, a broken rule and so on.
  // A suspended student can still log in, but every page of the student side
  // shows only the notice and its reason, and every student action refuses.
  // Nothing is deleted: lifting it puts them back exactly where they were.
  // suspendedById is a plain column, not a relation, so the record outlives
  // the admin account that set it.
  suspendedAt      DateTime?
  suspensionReason String?
  suspendedById    String?

  // Which language a student reads bilingual question sets in: "ms", "en",
  // or null for both side by side, as printed. Chosen on the set page and
  // kept on the account so it follows them to another device.
  questionLanguage String?

  createdQuestionSets QuestionSet[] @relation("QuestionSetCreator")
  createdSimulations  Simulation[]  @relation("SimulationCreator")
  createdQuestions    Question[]    @relation("QuestionCreator")
  submissions         Submission[]  @relation("SubmissionStudent")
  reviewedSubmissions Submission[]  @relation("SubmissionReviewer")

  createdCatalogueItems CatalogueItem[]   @relation("CatalogueItemCreator")
  redemptions           Redemption[]      @relation("StudentRedemptions")
  pointAdjustments      PointAdjustment[] @relation("StudentPointAdjustments")
  madeAdjustments       PointAdjustment[] @relation("PointAdjustmentCreator")

  subjects StudentSubject[] // students only - a student can take multiple subjects
  // Teachers only - the subjects whose question sets they may edit. Admins
  // edit every subject and have none here. See src/lib/permissions.ts.
  teachingSubjects TeacherSubject[]
  checkIns CheckIn[]        @relation("StudentCheckIns")

  createdAnnouncements Announcement[] @relation("AnnouncementCreator")
  createdPopupAds      PopupAd[]      @relation("PopupAdCreator")

  pet          Pet?          @relation("StudentPet")
  petPurchases PetPurchase[] @relation("StudentPetPurchases")

  feedback Feedback[] @relation("StudentFeedback")
}

// A notice that scrolls across the top of the portal. Admins write the text
// and choose the window it runs for at /admin/announcements. Several can be
// stored at once; whichever are live at page load share the ticker.
model Announcement {
  id      String @id @default(cuid())
  message String

  // The window this runs for, as UTC instants. The admin picks them in
  // Malaysian time (see CHECK_IN_TIME_ZONE) and the action converts. A null
  // start means "live already"; a null end means "until switched off".
  startsAt DateTime?
  endsAt   DateTime?

  // A manual off switch, independent of the dates - so a notice can be pulled
  // early, or written ahead of time and armed later, without losing the window.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation("AnnouncementCreator", fields: [createdById], references: [id])
  createdById String

  // Every page load asks "what is live right now", so the filter columns are
  // indexed together.
  @@index([isActive, startsAt, endsAt])
}

// A full-image notice shown over the page once per login, managed alongside
// the ticker at /admin/announcements. Same on/off switch and scheduling window
// as Announcement; the difference is that this one is a picture, so the image
// is the whole point and the caption is optional.
model PopupAd {
  id       String  @id @default(cuid())
  title    String?
  imageUrl String
  // Optional click-through. Stored as given and rendered with rel="noopener",
  // since it can point anywhere off-site.
  linkUrl  String?

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation("PopupAdCreator", fields: [createdById], references: [id])
  createdById String

  @@index([isActive, startsAt, endsAt])
}

// One row per day a student opens the portal and claims their daily bonus.
// The bonus marks live here rather than in PointAdjustment because that model
// requires an admin as createdById, and a check-in has no admin behind it.
model CheckIn {
  id String @id @default(cuid())

  student   User   @relation("StudentCheckIns", fields: [studentId], references: [id])
  studentId String

  // The calendar day in CHECK_IN_TIME_ZONE as "YYYY-MM-DD". Stored as a
  // string so "one check-in per day" is a plain unique constraint instead of
  // a timestamp-range query that would shift with the server's zone.
  day String

  // Consecutive days including this one, snapshotted at claim time so the
  // history stays readable even if a later day is missed.
  streak        Int @default(1)
  pointsAwarded Int @default(0)

  createdAt DateTime @default(now())

  @@unique([studentId, day])
}

// A subject (by name, matching Subject master data) a student is enrolled
// in. Many-to-many via a plain join table since Subject is referenced by
// name elsewhere too (see the comment on the Grade/Subject models above).
model StudentSubject {
  id        String   @id @default(cuid())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  subject   String
  createdAt DateTime @default(now())

  @@unique([studentId, subject])
}

// A subject (by name, matching Subject master data) a teacher may edit
// question sets in. Same shape as StudentSubject, kept as its own table so
// what a teacher may touch is never confused with what a student studies.
// A teacher with no rows here can read every set but edit none.
model TeacherSubject {
  id        String   @id @default(cuid())
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  subject   String
  createdAt DateTime @default(now())

  @@unique([teacherId, subject])
}

// A gift/reward students can redeem with their points balance.
model CatalogueItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  cost        Int // points required to redeem
  isActive    Boolean @default(true)

  // Redeeming this unlocks the virtual cat instead of handing over a physical
  // gift - it flips User.petEnabled. An admin can still grant or revoke access
  // directly at /admin/pet; this is the route a student can take themselves.
  grantsPet Boolean @default(false)

  // How many are left to exchange. Null means no stock is kept - the cat
  // unlock, or anything the admin does not want to count. Every exchange
  // takes one, and none can be made at nought; an admin tops it back up.
  stock Int?
  // Most times one student may exchange this gift, ever. Null is no limit.
  limitPerStudent Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation("CatalogueItemCreator", fields: [createdById], references: [id])
  createdById String

  redemptions Redemption[]
}

// A student spending points on a catalogue item. `cost` is snapshotted at
// redemption time so later price changes don't rewrite history.
model Redemption {
  id        String   @id @default(cuid())
  cost      Int
  createdAt DateTime @default(now())

  student   User   @relation("StudentRedemptions", fields: [studentId], references: [id])
  studentId String

  catalogueItem   CatalogueItem @relation(fields: [catalogueItemId], references: [id])
  catalogueItemId String

  // When the gift was handed over - with the next material delivery. Null
  // while it is still to be prepared; that is the admin's pending list.
  // deliveredById is a plain column so the record outlives the admin account.
  deliveredAt   DateTime?
  deliveredById String?

  // Set when an admin turns the exchange down - the gift ran out, say. The
  // row stays, so the student can see what happened and why, but a rejected
  // exchange no longer counts as spent: the points come back by not being
  // subtracted, rather than by a second entry that could fail to be written.
  // Its stock is returned and it stops counting towards the student's limit.
  rejectedAt      DateTime?
  rejectionReason String?
  rejectedById    String?

  @@index([deliveredAt])
  // Every page a student opens sums their exchanges for the balance.
  @@index([studentId])
}

// A manual admin credit/deduction to a student's points balance, outside of
// quiz grading (e.g. correcting a mistake, awarding a bonus).
model PointAdjustment {
  id        String   @id @default(cuid())
  amount    Int // positive = credit, negative = deduct
  reason    String?
  createdAt DateTime @default(now())

  student   User   @relation("StudentPointAdjustments", fields: [studentId], references: [id])
  studentId String

  createdBy   User   @relation("PointAdjustmentCreator", fields: [createdById], references: [id])
  createdById String

  // Summed for the balance on every page a student opens.
  @@index([studentId])
}

model QuestionSet {
  id            String   @id @default(cuid())
  title         String
  description   String?
  subject       String   @default("General") // e.g. "Mathematics" - students only see their own subject's sets
  simulationUrl String? // optional embedded interactive simulation related to this set's topic (e.g. a PhET sim)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy   User   @relation("QuestionSetCreator", fields: [createdById], references: [id])
  createdById String

  questions Question[]
  grades    QuestionSetGrade[] // a set can be shared across multiple grades

  // Written Malay first, then English (see src/lib/bilingual.ts). Students
  // can then read it in either language, or both.
  bilingual Boolean @default(false)
}

// A grade (by name, matching Grade master data) a question set is visible
// to. Many-to-many via a plain join table, same pattern as StudentSubject
// above - a set like a shared "General Science" chapter can be assigned to
// more than one grade instead of just one.
model QuestionSetGrade {
  id            String      @id @default(cuid())
  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questionSetId String
  grade         String
  createdAt     DateTime    @default(now())

  @@unique([questionSetId, grade])
}

// An interactive simulation in the library (a PhET sim, usually), apart from
// any question set. Students see the ones tagged with their grade and one of
// their subjects, grouped by chapter, and open each on a page of its own.
// A set's own simulationUrl above is a separate, older thing: one sim shown
// above that set's questions.
model Simulation {
  id          String   @id @default(cuid())
  title       String
  description String?
  subject     String // matches Subject master data, like QuestionSet.subject
  // Free text, as the textbook names it ("Bab 5 Jirim / Chapter 5 Matter").
  // The library is grouped under it, with chapter numbers in numeric order.
  chapter     String?
  // The syllabus learning standard this covers, e.g. "5.1.2". Shown, not
  // used for anything.
  topicCode   String?
  url         String // the English version
  urlMs       String? // the Malay version, when there is one
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation("SimulationCreator", fields: [createdById], references: [id])
  createdById String

  grades SimulationGrade[]

  // The student library filters on these on every visit.
  @@index([subject, isActive])
}

// A grade a simulation is shown to - same pattern as QuestionSetGrade.
model SimulationGrade {
  id           String     @id @default(cuid())
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  simulationId String
  grade        String
  createdAt    DateTime   @default(now())

  @@unique([simulationId, grade])
}

model Question {
  id          String       @id @default(cuid())
  body        String
  explanation String?
  diagramUrl  String?
  // AI-generated study nudges for the cat companion, don't reveal the answer -
  // generated once by scripts/generate-hints.mjs and cached here
  hint1       String?
  hint2       String?
  type        QuestionType
  points      Int          @default(10)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questionSetId String

  createdBy   User   @relation("QuestionCreator", fields: [createdById], references: [id])
  createdById String

  choices     Choice[]
  submissions Submission[]
}

model Choice {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String

  submissions Submission[]
}

model Submission {
  id String @id @default(cuid())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String

  student   User   @relation("SubmissionStudent", fields: [studentId], references: [id])
  studentId String

  // set when the question is MULTIPLE_CHOICE
  selectedChoice   Choice? @relation(fields: [selectedChoiceId], references: [id])
  selectedChoiceId String?

  // set when the question is FREE_RESPONSE
  answerText String?

  status        SubmissionStatus @default(PENDING)
  pointsAwarded Int              @default(0)

  // --- integrity signals -------------------------------------------------
  // Recorded to help a teacher spot answers worth a conversation. None of
  // them proves anything on its own: a fast correct answer often just means
  // the student knew it, and a tab switch is as likely to be a notification
  // as anything else. They are shown to the admin as context, never as a
  // verdict, and never to the student while they are answering.

  /**
   * Seconds between the question appearing and the answer being submitted.
   */
  secondsTaken  Int?
  /**
   * Times the tab lost focus while this question was open.
   */
  awayCount     Int  @default(0)
  /**
   * Total seconds spent with the tab hidden while this question was open.
   */
  awaySeconds   Int  @default(0)
  /**
   * Paste attempts blocked on this question.
   */
  pasteAttempts Int  @default(0)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewer   User?     @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  reviewerId String?

  // a student may only answer a given question once
  @@unique([questionId, studentId])
  // The unique index above starts with questionId, so it cannot find one
  // student's answers; without this, the balance shown on every student page
  // read the whole Submission table. Turso bills each row read.
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Virtual cat. Opt-in per student (User.petEnabled), paid for out of the same
// points balance as the catalogue, so a snack genuinely competes with saving
// for a real reward.
// ---------------------------------------------------------------------------

enum PetItemKind {
  CLOTHING // worn, kept forever, can be taken on and off
  FOOD // eaten once, mostly fills hunger
  SNACK // eaten once, mostly raises happiness
}

model Pet {
  id      String @id @default(cuid())
  owner   User   @relation("StudentPet", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String @unique // one cat per student

  name String
  // Coat colour chosen at adoption, as a key the renderer maps to fills.
  coat String @default("grey")

  // Hunger and happiness as they stood at statsAt. They decay with real time,
  // so the value that matters is derived on read - see currentStats() in
  // src/lib/pet.ts. Storing a reading plus its timestamp keeps this to plain
  // arithmetic instead of a scheduled job ticking every pet in the database.
  hunger    Int      @default(100)
  happiness Int      @default(100)
  statsAt   DateTime @default(now())

  adoptedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owned     PetOwnedItem[]
  purchases PetPurchase[]
}

// Something an admin has put in the shop. Clothing is bought once and kept;
// food and snacks are consumed on purchase.
model PetItem {
  id String @id @default(cuid())

  // Stable identifier the SVG renderer switches on, e.g. "hat-party". Kept
  // separate from the display name so an admin can rename an item without
  // the artwork disappearing.
  key  String      @unique
  name String
  kind PetItemKind

  // Clothing only: which layer it occupies, so a second hat replaces the
  // first rather than stacking. Null for food and snacks.
  slot String?

  cost Int

  // Food and snacks only: what eating it adds, before clamping to 100.
  hungerEffect    Int @default(0)
  happinessEffect Int @default(0)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owned     PetOwnedItem[]
  purchases PetPurchase[]

  @@index([kind, isActive, sortOrder])
}

// A piece of clothing a pet owns. Food is never recorded here - it is eaten
// at the moment of purchase.
model PetOwnedItem {
  id String @id @default(cuid())

  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId String

  item   PetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  equipped   Boolean  @default(false)
  acquiredAt DateTime @default(now())

  @@unique([petId, itemId]) // buying the same hat twice is a no-op, not a duplicate
}

// Every point spent on the cat. Separate from Redemption, which is tied to a
// CatalogueItem, but subtracted from the same balance - see getStudentBalance.
// cost is snapshotted so later price changes never rewrite history.
model PetPurchase {
  id String @id @default(cuid())

  // Denormalised onto the student as well as the pet, so the balance query
  // stays a single aggregate rather than a join through Pet.
  student   User   @relation("StudentPetPurchases", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId String

  item   PetItem @relation(fields: [itemId], references: [id])
  itemId String

  cost      Int
  createdAt DateTime @default(now())

  @@index([studentId])
}

// A record of each time the portal was reset back to zero. Exists mainly so
// the scheduled reset can tell whether it has already run - without it, a
// daily job would wipe the portal again every single day after the date
// passes. Doubles as an audit trail of what was destroyed and where the
// snapshot went.
// A teacher clearing one student's answers so they can sit the work again.
//
// Logged for the same reason submissions record their reviewer: a student's
// marks changing needs to be answerable afterwards. Deleting the submissions
// is otherwise silent - the answers simply are not there any more, and there
// is nothing to say a teacher meant it.
model AnswerReset {
  id String @id @default(cuid())

  ranAt DateTime @default(now())

  // Ids kept as plain columns rather than relations, like PortalReset above.
  // The log has to outlive what it refers to: a foreign key would either block
  // deleting a question set later or quietly take this record with it, and an
  // audit trail that disappears when the evidence does is not one. The names
  // are stored alongside for the same reason - so the entry still reads
  // properly once the set has been renamed or the account is gone.
  studentId   String
  studentName String

  // Null when the whole of a student's history was cleared at once.
  questionSetId    String?
  questionSetTitle String?

  clearedById   String?
  clearedByName String?

  answersCleared Int @default(0)
  // Marks the student loses by clearing, and will earn again on the redo.
  marksWithdrawn Int @default(0)

  @@index([studentId])
}

model PortalReset {
  id String @id @default(cuid())

  ranAt DateTime @default(now())

  // The scheduled date this run satisfied. Null for a manual reset, which is
  // what keeps a hand-run reset from cancelling the scheduled one.
  scheduledFor DateTime?

  // Null when run by the cron, otherwise the admin who pressed the button.
  triggeredById String?

  // Where the pre-wipe snapshot was stored. Null only if the export failed
  // and an admin chose to continue anyway.
  snapshotUrl String?

  submissionsCleared  Int @default(0)
  checkInsCleared     Int @default(0)
  adjustmentsCleared  Int @default(0)
  redemptionsCleared  Int @default(0)
  petPurchasesCleared Int @default(0)

  @@index([scheduledFor])
}

// ---------------------------------------------------------------------------
// Live quiz: a host-run, Kahoot-style game anyone can join by scanning a QR
// code and typing a name. Deliberately separate from Submission and the
// points economy - the players are members of the public with no account, and
// a game played in a hall should not move anyone's marks or scoreboard place.
// ---------------------------------------------------------------------------

enum LiveQuizStatus {
  LOBBY
  RUNNING
  FINISHED
}

model LiveQuiz {
  id String @id @default(cuid())

  // Six digits, typed by players who do not scan. Unique among games still in
  // use rather than forever, which the column cannot express - see
  // generateCode() in src/lib/actions/live.ts.
  code  String
  title String

  // The set it was built from, and a snapshot of which of its questions, in
  // play order. Snapshotting means editing the set mid-game, or shuffling,
  // cannot change the order players are already part-way through. Plain
  // columns rather than relations, like PortalReset: deleting the set or the
  // host later should not take the game's results with it.
  questionSetId      String?
  questionIds        String // JSON array of Question ids
  secondsPerQuestion Int     @default(20)
  hostId             String

  status       LiveQuizStatus @default(LOBBY)
  // -1 in the lobby, then 0-based.
  currentIndex Int            @default(-1)
  // The current question opens at startsAt - a few seconds after the host
  // presses Next, so every phone has caught up before the clock starts - and
  // closes at endsAt. The phase in between is derived from these, never
  // stored, so a game cannot get stuck because nobody pressed "reveal".
  startsAt     DateTime?
  endsAt       DateTime?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  participants LiveParticipant[]
  answers      LiveAnswer[]

  @@index([code])
}

model LiveParticipant {
  id     String   @id @default(cuid())
  quiz   LiveQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId String

  name    String
  // Lower-cased for the uniqueness check, so "Ali" and "ali" cannot both join
  // and confuse everyone reading the scoreboard.
  nameKey String

  // What the player's phone proves it is them with. Only the hash is kept, so
  // reading the table does not let anyone answer as someone else.
  tokenHash String @unique

  score    Int      @default(0)
  // Set when the host removes a player - an unpleasant name, usually. Kept as
  // a flag rather than deleted so they cannot simply rejoin under it.
  removed  Boolean  @default(false)
  joinedAt DateTime @default(now())

  answers LiveAnswer[]

  @@unique([quizId, nameKey])
}

model LiveAnswer {
  id            String          @id @default(cuid())
  quiz          LiveQuiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId        String
  participant   LiveParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String

  questionIndex Int
  choiceId      String
  correct       Boolean
  points        Int
  answeredAt    DateTime @default(now())

  // One answer per player per question: a second tap is refused by the
  // database, not just hidden by the phone.
  @@unique([participantId, questionIndex])
  @@index([quizId, questionIndex])
}

// ---------------------------------------------------------------------------
// YH-ideal-payment: tuition fee receipts. Served at its own address by
// src/proxy.ts, admin only. Money is held in sen (RM1 = 100) so sums are exact.
//
// A receipt stands on its own - a name and an email typed by the admin, not a
// portal account - and is emailed to that address once the admin has checked
// it. The price depends on the grade and how many subjects are taken, with a
// promotional price for paying several months at once: src/lib/fee-plans.ts.
// ---------------------------------------------------------------------------

model FeeReceipt {
  id        String @id @default(cuid())
  receiptNo String @unique

  // Who pays and is billed - usually a parent - and where the receipt goes.
  name  String
  email String

  // The children paid for, one class line each, as JSON:
  // [{ name, grade, subjects: [..], startMonth: "2026-10", months,
  //    normalSen, tuitionSen, priceNote }]
  // normalSen is every month at the monthly price; tuitionSen what was
  // charged after any promotion. Kept as made, so later price changes leave
  // the receipt as it was.
  students String @default("[]")

  normalSen Int // the children's normalSen together
  amountSen Int // everything paid: tuition, extra charges and tax, less discount

  // One-off charges ticked on the receipt - the material fee and so on - as
  // JSON [{ label, amountSen }], with the names and amounts they had then, as
  // FeeExtra may change later. extraSen is their total.
  extras   String @default("[]")
  extraSen Int    @default(0)

  // A discount the admin gives on top of any promotion, with its reason.
  // Shown with the promotion's saving as the template's DISCOUNT.
  extraDiscountSen Int     @default(0)
  discountNote     String?

  // Tax, as on the centre's template: a rate on SUBTOTAL LESS DISCOUNT.
  // taxRateBp is in basis points (600 = 6.00%); taxSen is the tax charged.
  taxRateBp Int @default(0)
  taxSen    Int @default(0)

  method String // CASH | TRANSFER | OTHER
  paidOn String // "2026-10-18", the day the money was received
  note   String?

  createdAt   DateTime @default(now())
  createdById String

  // The email: when it went, and why it did not if it failed. A receipt is
  // saved before it is sent, so a failed email can simply be sent again.
  sentAt    DateTime?
  sendError String?

  // A receipt made by mistake is voided, never deleted: its number stays used
  // and the record shows who voided it and why.
  voidedAt   DateTime?
  voidReason String?
  voidedById String?

  @@index([createdAt])
  @@index([email])
}

// The subjects a receipt can be ticked for, kept by YH-ideal-payment itself -
// apart from the portal's Subject list, which decides which question sets a
// student sees. A receipt stores the names it was made with, so deleting a
// subject here leaves old receipts as they were.
model FeeSubject {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// The price list receipts are worked out from, edited on YH-ideal-payment's
// Prices page. One row per grade group and number of subjects: the monthly
// price, and optionally a promotional price for paying promoMonths at once.
// The grade groups themselves are fixed in src/lib/fee-plans.ts. A receipt
// keeps the amounts it was made with, so changing a price leaves old ones be.
model FeePrice {
  id          String   @id @default(cuid())
  band        String // "G6" | "F13" | "F45" - see BANDS in src/lib/fee-plans.ts
  subjects    Int
  monthlySen  Int
  promoMonths Int?
  promoSen    Int?
  updatedAt   DateTime @updatedAt

  @@unique([band, subjects])
}

// The one-off charges a receipt can include with a tick - the material fee
// and any others the admin adds. Edited on the Prices page.
model FeeExtra {
  key       String   @id // "material" for the first; new ones get a cuid
  label     String
  amountSen Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Settings for YH-ideal-payment, one value per key. "taxRateBp" is the tax
// rate a new receipt starts with, in basis points (600 = 6.00%).
model FeeSetting {
  key   String @id
  value String
}

// A "forgot password" link. Only a hash of the token is kept, so the database
// alone cannot be used to reset anyone's password; the token itself exists
// only in the email. A link works once, for an hour, and asking for a new one
// retires the old.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Someone asking for a student account from the login page, waiting for staff
// at /admin/students/requests. No password is kept here: approving creates
// the account with a freshly generated one and emails it, so the password
// only ever exists as a hash and in that email. Approving or rejecting
// deletes the row.
model AccountRequest {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}

enum FeedbackKind {
  IDEA
  SUGGESTION
  FEEDBACK
}

// How a student agreed to be named if their words are quoted on the website.
enum FeedbackCredit {
  FULL_NAME
  FIRST_NAME_GRADE // "Aisyah, Form 2"
  ANONYMOUS
}

// An idea, suggestion or piece of feedback a student sent from
// /dashboard/feedback, read by the admin at /admin/feedback. The admin can
// star the good ones as testimonials for the public website, but only those
// the student allowed to be quoted.
//
// creditLine is the name exactly as it would appear under the quote, written
// when the student sends it - so a later change of name or grade on the
// account never puts words to a name the student did not agree to. It is
// null whenever quoting is not allowed, and so is credit.
//
// Feedback outlives the account: deleting a student clears studentId and
// keeps the message, still credited as the student chose. studentName and
// studentGrade are who wrote it, as at sending, so the admin's list still
// reads properly once the account is gone.
model Feedback {
  id           String       @id @default(cuid())
  student      User?        @relation("StudentFeedback", fields: [studentId], references: [id], onDelete: SetNull)
  studentId    String?
  studentName  String
  studentGrade String?
  kind         FeedbackKind
  message      String

  // Optional, answered with the message: 1 to 5 stars for Mr Tan, and whether
  // they would recommend him to a friend. Null when skipped.
  rating         Int?
  wouldRecommend Boolean?

  mayQuote   Boolean         @default(false)
  credit     FeedbackCredit?
  creditLine String?

  readAt     DateTime?
  starredAt  DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())

  // The student's own history and the daily cap both read by student and date.
  @@index([studentId, createdAt])
  @@index([createdAt])
}

// Portal-wide switches an admin flips, one value per key. "feedbackEnabled"
// is "false" while the student Feedback page is closed; with no row it is
// open. The payment site keeps its own settings in FeeSetting.
model PortalSetting {
  key   String @id
  value String
}
