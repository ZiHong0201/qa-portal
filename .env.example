# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Zoom Server-to-Server OAuth app ---------------------------------------
# Zoom App Marketplace > Develop > Build App > Server-to-Server OAuth
# Scopes needed: cloud_recording:read:list_user_recordings:admin
#                cloud_recording:delete:meeting_recording:admin
#                user:read:user:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Apple Calendar (iCloud CalDAV) ----------------------------------------
# Password is an APP-SPECIFIC password from appleid.apple.com (needs 2FA on),
# never your real Apple ID password. Revoke it independently if it leaks.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Only if calendar.source is "ics" instead of "caldav":
CALENDAR_ICS_URL=

# --- Claude ----------------------------------------------------------------
# LEAVE BLANK unless you change classify.backend to "api". The default
# "claude-code" backend authenticates with your Claude subscription instead,
# so there is no API bill and no key to manage.
ANTHROPIC_API_KEY=

# --- Telegram (optional, free) ---------------------------------------------
# Create a bot with @BotFather, then message it once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
